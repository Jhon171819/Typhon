import json
import typhon.auth as auth
import typhon.http as http
import typhon.postgres as pg
import typhon.redis as redis
import typhon.web as web

pool_options: dict[str, Any] = {'max_connections': 1, 'share': 'tenant_records'}
db: pg.Connection = pg.connect_pooled(pg.env('DATABASE_URL'), pool_options)
cache: redis.Connection = redis.connect(redis.env('REDIS_URL'))
token: auth.Authenticator = auth.jwt(
    http.env('AUTH_ISSUER'), http.env('AUTH_AUDIENCE'), http.env('AUTH_JWKS_URL')
)
policy: auth.Policy = auth.policy({'member': ['records:read', 'records:write']})
routes: web.Router = web.router()
routes.use_errors()

def cache_key(req: http.Request) -> str:
    fields: list[Any] = [req.tenant, req.param('id')]
    return 'typhon:rls:records:v1:' + json.dumps(fields)

def read_record(tx: pg.Transaction, req: http.Request) -> Any:
    rows: pg.Rows = tx.query('SELECT label FROM tenant_records WHERE id = $1', [req.param('id')])
    if rows.count == 0:
        return None
    return {'label': rows.get(0, 'label')}

def create_record(tx: pg.Transaction, req: http.Request) -> Any:
    tx.exec(
        "INSERT INTO tenant_records (tenant_id, id, label) VALUES (pg_catalog.current_setting('typhon.tenant_id'), $1, $2)",
        [req.param('id'), req.body]
    )
    tx.commit()
    return 1

def update_record(tx: pg.Transaction, req: http.Request) -> Any:
    affected: int = tx.exec('UPDATE tenant_records SET label = $2 WHERE id = $1', [req.param('id'), req.body])
    tx.commit()
    return affected

def delete_record(tx: pg.Transaction, req: http.Request) -> Any:
    affected: int = tx.exec('DELETE FROM tenant_records WHERE id = $1', [req.param('id')])
    tx.commit()
    return affected

def read(req: http.Request) -> http.Response:
    key: str = cache_key(req)
    stored: str | None = cache.get(key)
    if stored is not None:
        return http.response(200, stored, [['Content-Type', 'application/json']])
    value: Any = db.tenant_transaction(req, read_record, 'read_committed', True)
    if value is None:
        return web.problem(req, 404)
    body: str = json.dumps(value)
    cache.set(key, body, 10)
    return http.response(200, body, [['Content-Type', 'application/json']])

def create(req: http.Request) -> http.Response:
    db.tenant_transaction(req, create_record)
    cache.delete(cache_key(req))
    return http.response(201, 'created')

def update(req: http.Request) -> http.Response:
    edited: int = db.tenant_transaction(req, update_record)
    if edited == 0:
        return web.problem(req, 404)
    cache.delete(cache_key(req))
    return http.response(204, '')

def remove(req: http.Request) -> http.Response:
    removed: int = db.tenant_transaction(req, delete_record)
    if removed == 0:
        return web.problem(req, 404)
    cache.delete(cache_key(req))
    return http.response(204, '')

routes.add('GET', '/records/{id}', read)
routes.require_auth('GET', '/records/{id}', token)
routes.authorize('GET', '/records/{id}', policy, 'records:read')

routes.add('POST', '/records/{id}', create)
routes.require_auth('POST', '/records/{id}', token)
routes.authorize('POST', '/records/{id}', policy, 'records:write')

routes.add('PUT', '/records/{id}', update)
routes.require_auth('PUT', '/records/{id}', token)
routes.authorize('PUT', '/records/{id}', policy, 'records:write')

routes.add('DELETE', '/records/{id}', remove)
routes.require_auth('DELETE', '/records/{id}', token)
routes.authorize('DELETE', '/records/{id}', policy, 'records:write')

if __name__ == '__main__':
    http.serve('127.0.0.1:8080', routes)
