import typhon.http as http


pile: list[list[str]] = [
    ['test1', 'test'],
    ['test1', 'test'],
    ['test1', 'test'],
    ['test1', 'test'],
    ['test1', 'test'],
    ['test1', 'test'],
    ['test1', 'test'],
    ['test1', 'test'],
]


def handle(req: http.Request) -> http.Response:
    path: str  =  req.path
    if path == '/health':
        return http.response(200, 'ok', [['Content-Type', 'text/plain; charset=utf-8']])
    if path == '/echo':
        return http.json(200, [req.method, req.query('name'), req.body])

    if path == '/pile':
        return http.json(200, pile)

    return http.response(404, 'not found')


print('HTTP em http://127.0.0.1:8080; Ctrl+C para encerrar')
http.serve('127.0.0.1:8080', handle)
