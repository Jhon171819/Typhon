import typhon.http as http
import typhon.web as web

users: dict[str, str] = {}
routes: web.Router = web.router()

def search(req: http.Request) -> http.Response:
    return http.json(200, {'tags': req.query_all('tag'), 'limit': req.query('limit'), 'offset': req.query('offset')})

def create(req: http.Request) -> http.Response:
    payload: dict[str, str] = req.json()
    id: str = payload['id']
    if id in users:
        return http.response(409, 'already exists')
    users[id] = payload['name']
    return http.json(201, {'id': id, 'name': users[id]})

def get_user(req: http.Request) -> http.Response:
    id: str = req.param('id')
    if id not in users:
        return http.response(404, 'user not found')
    return http.json(200, {'id': id, 'name': users[id]})

def update(req: http.Request) -> http.Response:
    id: str = req.param('id')
    if id not in users:
        return http.response(404, 'user not found')
    payload: dict[str, str] = req.json()
    users[id] = payload['name']
    return http.json(200, {'id': id, 'name': users[id]})

def delete_user(req: http.Request) -> http.Response:
    id: str = req.param('id')
    if id not in users:
        return http.response(404, 'user not found')
    del users[id]
    return http.response(204, '')

routes.add('GET', '/v1/users/search', search)
routes.add('POST', '/v1/users', create)
routes.add('GET', '/v1/users/{id}', get_user)
routes.add('PUT', '/v1/users/{id}', update)
routes.add('PATCH', '/v1/users/{id}', update)
routes.add('DELETE', '/v1/users/{id}', delete_user)

if __name__ == '__main__':
    http.serve('127.0.0.1:8080', routes)
